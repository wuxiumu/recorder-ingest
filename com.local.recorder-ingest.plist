<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd 定时配置：每 15 分钟运行一次。
     使用前把两处 __PROJECT_DIR__ 替换为本项目的绝对路径，
     然后： cp 本文件 ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.local.recorder-ingest.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.recorder-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__PROJECT_DIR__/ingest.py</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/ingest.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/ingest.err</string>
</dict>
</plist>
